{
    "name": "jira-markdown-syntax",
    "displayName": "jira-markdown-syntax",
    "description": "JIRA Markdown Syntax",
    "version": "0.0.1",
    "engines":
    {
        "vscode": "^1.103.0"
    },
    "categories":
    [
        "Other"
    ],
    "main": "./out/extension.js",
    "license": "MIT",
    "repository":
    {
        "type": "git",
        "url": "https://github.com/valery-arzumanov/jira-markdown-syntax.git"
    },
    "contributes":
    {
        "languages":
        [
            {
                "id": "jira-markdown",
                "extensions": [ ".jira" ],
                "aliases": [ "JIRA Markdown" ],
                "icon":
                {
                    "light": "./icons/jira-markdown-vscode.webp",
                    "dark": "./icons/jira-markdown-vscode.webp"
                },
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars":
        [
            {
                "language": "jira-markdown",
                "scopeName": "source.jira.markdown",
                "path": "./syntaxes/jira-markdown.tmLanguage.json"
            }
        ],
        "snippets":
        [
            {
                "language": "jira-markdown",
                "path": "./snippets/jira-markdown.json"
            }
        ]
    },
    "scripts":
    {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies":
    {
        "@types/vscode": "^1.103.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "eslint": "^9.32.0",
        "typescript": "^5.9.2",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2"
    }
}
